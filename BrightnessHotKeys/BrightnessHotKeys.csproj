<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net9.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SupportedOSPlatform>windows</SupportedOSPlatform>
		<!-- Remove or disable trimming -->
		<PublishTrimmed>false</PublishTrimmed>
		<PublishReadyToRun>true</PublishReadyToRun>
		<Platforms>AnyCPU;x64</Platforms>
	</PropertyGroup>

	<PropertyGroup>
		<StartupObject>BrightnessHotKeys.Program</StartupObject>
	</PropertyGroup>

	<!-- Define ItemGroups with conditions to control when packages are included -->
	<ItemGroup>
		<!-- Always include System.Management -->
		<PackageReference Include="System.Management" Version="9.0.4" />
	</ItemGroup>

	<!-- Include test packages only for Debug builds or when explicitly building tests -->
	<ItemGroup Condition="'$(Configuration)'=='Debug' Or '$(BuildTests)'=='true'">
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
		<PackageReference Include="xunit" Version="2.9.3" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="BrightnessHotKeys.ico" />
	</ItemGroup>

	<!-- Auto-publish on Release build with trimming disabled -->
	<Target Name="AutoPublish" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' And '$(PublishingFromBuild)' != 'true'">
		<Message Text="Auto-publishing single file executable..." Importance="high" />
		<Exec Command="dotnet publish &quot;$(ProjectPath)&quot; -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:PublishTrimmed=false -p:PublishReadyToRun=true -p:IncludeNativeLibrariesForSelfExtract=true -p:BuildTests=false -p:PublishingFromBuild=true -o &quot;$(SolutionDir)SingleFileOutput&quot;" />
		<Message Text="Published to: $(SolutionDir)SingleFileOutput" Importance="high" />
	</Target>

</Project>
